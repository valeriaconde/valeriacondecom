---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { lists } from '@/data/life';
---

<Base title="Lists">
  <PageHeader
    eyebrow="Lists"
    title="Lists"
    accent="(obviously)"
    lead="Because lists are a perfectly valid form of writing. Updated whenever I feel like it."
  />

  <section class="container-x pb-32">
    <div class="columns-1 gap-6 md:columns-2 [&>*]:mb-6">
      {
        lists.map((list) => (
          <div class="card break-inside-avoid p-8" data-reveal>
            <h2 class="display-sm mb-6">{list.title}</h2>
            <ol class="space-y-3" data-reveal-stagger="0.06">
              {list.items.map((item, i) => (
                <li class="flex gap-4 text-muted">
                  <span class="display w-5 shrink-0 text-rose">{i + 1}</span>
                  <span>{item}</span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>
</Base>
