---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { lists, listsText } from '@/data/life';
import { langOf, tr } from '@/i18n';

const lang = langOf(Astro.url);
---

<Base title="Lists">
  <PageHeader
    eyebrow="Lists"
    title="Lists"
    accent="(obviously)"
    lead={tr(listsText.lead, lang)}
    leadHref={listsText.leadHref}
  />

  <section class="container-x pb-32">
    <div class="columns-1 gap-6 md:columns-2 [&>*]:mb-6">
      {
        lists.map((list) => (
          <div id={list.id} class="card break-inside-avoid scroll-mt-24 p-8" data-reveal>
            <h2 class="display-sm mb-6">{list.title}</h2>
            {list.items.length > 0 ? (
              <ol class="space-y-3" data-reveal-stagger="0.06">
                {list.items.map((item, i) => (
                  <li class="flex gap-4 text-muted">
                    <span class="display w-5 shrink-0 text-rose">{i + 1}</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="serif-italic text-muted">{tr(listsText.empty, lang)}</p>
            )}
          </div>
        ))
      }
    </div>
  </section>
</Base>
