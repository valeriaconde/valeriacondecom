---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Swatch from '@/components/Swatch.astro';
import { trips } from '@/data/life';
---

<Base title="Travel">
  <PageHeader
    eyebrow="Travel"
    title="Places"
    accent="& notes"
    lead="Trips I've taken and the notes I brought back. More photographs than words, more questions than answers."
  />

  {
    trips.map((trip, i) => (
      <article class="border-t border-line">
        <div class="container-x py-20 sm:py-28">
          <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
            <div>
              <p class="mono mb-4 text-rose">
                0{i + 1} · {trip.dates}
              </p>
              <h2 class="display-lg" data-split>{trip.destination}</h2>
              <p class="mt-8 text-lg" data-reveal>{trip.description}</p>
            </div>
            <div class="grid grid-cols-2 gap-3 self-start" data-reveal-stagger="0.08">
              {trip.photos.map((photo, pi) => (
                <Swatch {...photo} class:list={['aspect-square', pi % 2 === 1 && 'translate-y-8']} />
              ))}
            </div>
          </div>
        </div>
      </article>
    ))
  }
</Base>
