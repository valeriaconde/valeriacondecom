---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import LatelyTeaser from '@/components/LatelyTeaser.astro';
import { getPresents } from '@/lib/presents';
import { showPresentsOnHomepage, presentsHome, homepagePresents } from '@/data/presents';
import { langOf, tr } from '@/i18n';
import { listCards, listCardsText } from '@/data/listCards';
import { lists } from '@/data/life';
import { inspiration, inspirationText } from '@/data/inspiration';
import type { ImageMetadata } from 'astro';
import { roles } from '@/data/site';
import heroPhoto from '@/assets/hero.jpg';


const sections = [
  // Hidden for now (rename src/pages/_travel.astro, _photography.astro, _projects.astro to bring them back):
  // { href: '/travel', label: 'Travel', description: 'Trips, stories, and photographs.' },
  // { href: '/photography', label: 'Photography', description: 'Scenes I wanted to keep.' },
  { href: '/recommendations', label: 'Recommendations', description: 'Stuff I loved and think you will too.' },
  // { href: '/projects', label: 'Code', description: 'Making things exist.' },
  { href: '/about', label: 'About', description: 'The longer version of who I am.' },
];


const lang = langOf(Astro.url);
// Read out in full by screen readers, since the visible words rotate
const roleWords = roles.map((r) => tr(r, lang));
const roleList = `${roleWords.slice(0, -1).join(', ')} ${lang === 'es' ? 'y' : '&'} ${roleWords.at(-1)}.`;
const listCardImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/lists/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const listCardImage = (file?: string) => {
  if (!file) return undefined;
  const img = listCardImages[`/src/assets/lists/${file}`]?.default;
  if (!img) throw new Error(`List card image "${file}" not found in src/assets/lists/`);
  return img;
};
const listFor = (id?: string) => {
  if (!id) return undefined;
  const list = lists.find((l) => l.id === id);
  if (!list) throw new Error(`listCards: no list with id "${id}" in src/data/life.ts`);
  return list;
};
const allPresents = showPresentsOnHomepage ? await getPresents() : [];
const presentPreviews = showPresentsOnHomepage
  ? homepagePresents.map((title) => {
      const present = allPresents.find((p) => p.title === title);
      if (!present) throw new Error(`homepagePresents: no present titled "${title}" in src/data/presents.ts`);
      return present;
    })
  : [];
---

<Base>
  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="px-3 pt-[76px] pb-3 sm:px-4 sm:pb-4">
    <div class="hero-card relative isolate flex h-[calc(100dvh-88px)] min-h-[560px] flex-col justify-end overflow-hidden rounded-[28px] bg-paper-2 px-6 pb-10 sm:h-[calc(100dvh-92px)] sm:px-12 sm:pb-14">
      <div class="absolute inset-x-0 -top-[8%] -bottom-[8%] -z-10" data-parallax="0.1" aria-hidden="true">
        <Image
          src={heroPhoto}
          alt=""
          width={1320}
          widths={[640, 960, 1320]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover object-[50%_12%]"
          data-hero-zoom
        />
      </div>
      <!-- darken the bottom so the name stays readable -->
      <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent" aria-hidden="true"></div>

      <div class="flex flex-col gap-6 text-white lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h1 class="display-xl" data-split="chars">Valeria<br class="sm:hidden" /> Conde<span class="glow-dot">.</span></h1>
          <p class="serif-italic mt-5 text-[clamp(1.4rem,3vw,2.4rem)] leading-tight text-white/85" data-reveal data-load data-delay="0.9">
            <span class="sr-only">{roleList}</span>
            <span aria-hidden="true" class="inline-flex flex-wrap items-baseline gap-x-[0.3em]">
              <span class="glow-dot relative inline-grid overflow-hidden pb-[0.12em] text-left" data-rotator>
                {
                  roles.map((role, i) => (
                    <span data-rotator-item class:list={['col-start-1 row-start-1 whitespace-nowrap', i > 0 && 'opacity-0']}>
                      {tr(role, lang)}
                    </span>
                  ))
                }
              </span>
            </span>
          </p>
        </div>
        <div class="flex items-center gap-3" data-reveal data-load data-delay="1.1">
          <a href="/lately" class="btn bg-white text-ink hover:bg-rose-soft" data-magnetic>
            Lately <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Presents (temporary: turn off in src/data/presents.ts) ── -->
  {
    presentPreviews.length > 0 && (
      <section class="container-x py-16 sm:py-24" aria-labelledby="presents-title">
        <a href="/presents" data-pop-group class="tile group grid !bg-rose-soft p-6 sm:p-12 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-12" data-reveal>
          <div>
            <h2 id="presents-title" class="display-lg max-w-xl !text-[clamp(2.6rem,5vw,4.6rem)]">
              {lang === 'es' && <span class="glow-dot">¿</span>}{tr(presentsHome.title, lang)}<span class="glow-dot">?</span>
            </h2>
            <p class="lead mt-6 max-w-md !text-ink/70">{tr(presentsHome.teaser, lang)}</p>
            <span class="btn btn-primary mt-8">
              {tr(presentsHome.button, lang)} <span class="arrow" aria-hidden="true">→</span>
            </span>
          </div>
          <div class="relative mt-12 flex h-56 items-center justify-center sm:h-72 lg:mt-0" aria-hidden="true">
            {presentPreviews.map((p, i) => (
              <div
                class="absolute w-36 transition-transform duration-700 ease-[var(--ease-out-expo)] sm:w-48"
                style={`--x:${(i - (presentPreviews.length - 1) / 2) * 52}%; rotate:${[-8, 3, 10][i]}deg; translate: var(--x) ${[8, -12, 6][i]}px; z-index:${i === 1 ? 2 : 1}`}
                data-present-card
              >
                <div data-pop data-fan-x={(i - (presentPreviews.length - 1) / 2) * 52} data-fan-rotate={[-8, 3, 10][i]}>
                <div data-float>
                  <div class="aspect-square overflow-hidden rounded-2xl border-4 border-white bg-white shadow-[0_20px_40px_-18px_rgb(29_24_32/0.35)]">
                    {p.localImage ? (
                      <Image src={p.localImage} alt="" width={p.localImage.format === 'svg' ? undefined : 500} widths={p.localImage.format === 'svg' ? undefined : [300, 500]} sizes="200px" class="size-full object-cover" />
                    ) : p.remoteImage ? (
                      <img src={p.remoteImage} alt="" loading="lazy" referrerpolicy="no-referrer" class="size-full object-contain p-3" />
                    ) : (
                      <span class="grid size-full place-items-center text-4xl">🎁</span>
                    )}
                  </div>
                </div>
                </div>
              </div>
            ))}
          </div>
        </a>
      </section>
    )
  }

  <!-- ── Lately teaser ─────────────────────────────────────── -->
  <section class="container-x pb-16 sm:pb-24" aria-label="Lately">
    <div data-reveal>
      <LatelyTeaser />
    </div>
  </section>

  <!-- ── Lists ────────────────────────────────────────────── -->
  <section class="container-x pb-24 sm:pb-32" aria-labelledby="lists-title">
    <div class="mb-10 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2 id="lists-title" class="display-lg" data-split>
          {tr(listCardsText.title, lang)}<span class="glow-dot">.</span>
        </h2>
        <p class="lead mt-5 max-w-md" data-reveal>{tr(listCardsText.intro, lang)}</p>
      </div>
      <div data-reveal>
        <a href="/lists" class="btn btn-ghost" data-magnetic>
          {tr(listCardsText.button, lang)} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4" data-stair>
      {
        listCards.map((r) => {
          const image = listCardImage(r.image);
          const list = listFor(r.list);
          return (
            <a href={list ? `/lists#${list.id}` : '/lists'} class="tile group min-h-56 !justify-end p-5 sm:min-h-72 sm:p-6" style={`background:${r.tint}`}>
              {image && (
                <>
                  <Image
                    src={image}
                    alt=""
                    width={900}
                    widths={[300, 600, 900]}
                    sizes="(min-width: 1024px) 25vw, 50vw"
                    class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.05]"
                  />
                  <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/65 via-ink/10 to-transparent" aria-hidden="true" />
                </>
              )}
              <span class:list={['relative', image && 'text-white']} data-stair-text>
                <span class="display-md block !text-[clamp(1.3rem,2.4vw,2rem)]">{tr(r.title, lang)}</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- ── Get inspired: quotes hidden behind a blur, they come a little into focus on hover ── -->
  <section class="container-x pb-24 sm:pb-32" aria-labelledby="inspired-title">
    <a href="/get-inspired" class="tile inspired group relative min-h-[420px] !justify-center !border-ink !bg-ink p-8 text-paper sm:min-h-[480px] sm:p-14" data-reveal>
      <div class="inspired-words pointer-events-none absolute inset-0 flex flex-col justify-center gap-6 px-8 sm:px-14" aria-hidden="true">
        {inspiration.filter((i) => i.quote).slice(0, 3).map((i, n) => (
          <p class:list={['serif-italic text-3xl leading-tight sm:text-5xl', n % 2 && 'self-end text-right']}>“{tr(i.quote!, lang)}”</p>
        ))}
      </div>
      <div class="relative mx-auto flex max-w-md flex-col items-center text-center">
        <h2 id="inspired-title" class="display-lg">
          {tr(inspirationText.title, lang)}<span class="glow-dot">.</span>
        </h2>
      </div>
    </a>
  </section>

  <!-- ── Sections ─────────────────────────────────────────── -->
  <section class="mt-8 mb-24 border-t border-line sm:mt-12 sm:mb-32" aria-label="Sections">
    {
      sections.map(({ href, label, description }) => (
        <a href={href} class="index-row group block border-b border-line">
          <div class="container-x flex items-center justify-between gap-6 py-7 sm:py-9" data-reveal>
            <div class="index-title">
              <h2 class="display-md">{label}</h2>
              <p class="mt-1.5 max-w-md text-sm text-muted sm:text-base">{description}</p>
            </div>
            <span class="arrow shrink-0 text-2xl text-muted transition-colors duration-300 group-hover:text-rose-deep sm:text-3xl" aria-hidden="true">
              →
            </span>
          </div>
        </a>
      ))
    }
  </section>


  </Base>

<style>
  /* Get inspired: the quotes stay out of focus, sharpening a little on hover */
  .inspired-words {
    filter: blur(14px);
    opacity: 0.35;
    transition:
      filter 1.2s var(--ease-out-expo),
      opacity 1.2s var(--ease-out-expo);
  }
  .inspired:hover .inspired-words,
  .inspired:focus-visible .inspired-words {
    filter: blur(7px);
    opacity: 0.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .inspired-words {
      transition: none;
    }
  }
  /* The present pictures fan out a little more on hover */
  .group:hover [data-present-card]:nth-child(1) {
    translate: calc(var(--x) - 12%) 0;
  }
  .group:hover [data-present-card]:nth-child(3) {
    translate: calc(var(--x) + 12%) 0;
  }
  .group:hover [data-present-card]:nth-child(2) {
    translate: var(--x) -22px;
  }
</style>
