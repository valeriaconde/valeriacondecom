---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { recommendations, recommendationsText } from '@/data/recommendations';
import { langOf, tr } from '@/i18n';

const lang = langOf(Astro.url);

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/recommendations/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const imageFor = (file: string) => {
  const img = images[`/src/assets/recommendations/${file}`]?.default;
  if (!img) throw new Error(`Recommendation image "${file}" not found in src/assets/recommendations/`);
  return img;
};
---

<Base title="Recommendations" description="Things Valeria Conde recommends.">
  <PageHeader eyebrow="Curated" title="Things I" accent="love" lead={tr(recommendationsText.lead, lang)} />

  <section class="container-x pb-32">
    <ul class="grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-3" data-reveal-stagger="0.08">
      {
        recommendations.map((r) => (
          <li class="tile !justify-start">
            <span class="flex aspect-square items-center justify-center bg-rose-soft/40 p-8 sm:p-12">
              <span data-float class="block size-full">
                <Image
                  src={imageFor(r.image)}
                  alt=""
                  width={600}
                  widths={[300, 600]}
                  sizes="(min-width: 1024px) 30vw, 50vw"
                  class="size-full object-contain drop-shadow-[0_18px_24px_rgb(29_24_32/0.18)]"
                />
              </span>
            </span>
            <span class="flex flex-1 flex-col gap-1 border-t border-line p-5">
              <span class="text-xs text-muted">{r.maker}</span>
              <span class="font-display text-lg leading-snug sm:text-xl">{r.name}</span>
              {r.note && <span class="mt-1 text-sm text-muted">{tr(r.note, lang)}</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
