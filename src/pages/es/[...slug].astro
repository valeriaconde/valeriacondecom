---
/**
 * The Spanish site (/es/…). Every page here is the same page as the English one;
 * pages pick their Spanish text with tr() from src/i18n.ts, falling back to English.
 * A new page in src/pages/ also needs a line in `pages` below.
 */
import Home from '../index.astro';
import About from '../about.astro';
import Projects from '../projects.astro';
import Lists from '../lists.astro';
import Recommendations from '../recommendations.astro';
import Travel from '../travel.astro';
import Photography from '../photography.astro';
import Contact from '../contact.astro';
import Presents from '../presents.astro';
import Rankings from '../rankings.astro';
import Lately from '../lately/index.astro';
import Post from '../lately/[id].astro';
import { postPaths } from '@/lib/lately';

export async function getStaticPaths() {
  const pages = ['', 'about', 'projects', 'lists', 'recommendations', 'travel', 'photography', 'contact', 'presents', 'rankings', 'lately'];
  const posts = await postPaths();
  return [
    ...pages.map((page) => ({ params: { slug: page || undefined }, props: { page } })),
    ...posts.map(({ params, props }) => ({ params: { slug: `lately/${params.id}` }, props: { page: 'post', ...props } })),
  ];
}

const components = {
  '': Home,
  about: About,
  projects: Projects,
  lists: Lists,
  recommendations: Recommendations,
  travel: Travel,
  photography: Photography,
  contact: Contact,
  presents: Presents,
  rankings: Rankings,
  lately: Lately,
  post: Post,
} as const;

const { page, ...props } = Astro.props as { page: keyof typeof components } & Record<string, unknown>;
const Page = components[page] as any;
---

<Page {...props} />
