---
import Base from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import PageHeader from '@/components/PageHeader.astro';
import { bio, timeline } from '@/data/about';
import { langOf, tr } from '@/i18n';
import portrait from '@/assets/hero.jpg';

const lang = langOf(Astro.url);
---

<Base title="About">
  <PageHeader eyebrow="About" title="Valeria" accent="Conde" />

  <section class="container-x grid gap-12 pb-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-20">
    <div data-reveal>
      <Image
        src={portrait}
        alt="Valeria Conde"
        width={800}
        widths={[400, 600, 800]}
        sizes="(min-width: 1024px) 24rem, 100vw"
        class="aspect-[4/5] w-full max-w-sm rounded-[28px] object-cover object-[50%_12%]"
      />
    </div>

    <div data-reveal>
      <p class="display-sm serif-italic text-muted">{tr(bio, lang)}</p>
    </div>
  </section>

  <section class="container-prose py-28 sm:py-36">
    <p class="eyebrow mb-14" data-reveal="fade">Timeline</p>
    <ol class="relative">
      <span class="absolute top-2 bottom-2 left-[5px] w-px bg-line" aria-hidden="true"></span>
      <span class="absolute top-2 bottom-2 left-[5px] w-px origin-top bg-rose" data-grow-line aria-hidden="true"></span>
      {
        timeline.map(({ year, event, link }) => {
          const [before, after] = link ? event.split(link.text) : [event];
          return (
            <li class="relative grid gap-1 pb-12 pl-10 last:pb-0 sm:grid-cols-[6rem_1fr] sm:gap-8" data-reveal>
              <span class="absolute top-2 left-0 size-[11px] rounded-full border-2 border-rose bg-paper" />
              <span class="display text-2xl text-rose">{year}</span>
              <span class="text-lg">
                {before}
                {link && (
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="link-line">
                    {link.text}
                  </a>
                )}
                {after}
              </span>
            </li>
          );
        })
      }
    </ol>
  </section>
</Base>
