---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { socials } from '@/data/site';
import { langOf } from '@/i18n';

const es = langOf(Astro.url) === 'es';
---

<Base title={es ? 'Contacto' : 'Contact'}>
  <PageHeader
    eyebrow={es ? 'Contacto' : 'Contact'}
    title={es ? 'Ponte en' : 'Get in'}
    accent={es ? 'contacto' : 'touch'}
  />

  <section class="container-x pb-32">
    <p class="eyebrow mb-6" data-reveal="fade">{es ? 'En otros lados' : 'Elsewhere'}</p>
    <ul class="max-w-3xl border-t border-line" data-reveal-stagger="0.08">
      {
        socials.map(({ label, href }) => (
          <li class="border-b border-line">
            <a href={href} target="_blank" rel="noopener noreferrer" class="index-row group flex items-center justify-between gap-6 py-6 sm:px-4">
              <div class="index-title">
                <span class="display-sm">{label}</span>
              </div>
              <span class="arrow-ne text-2xl text-muted group-hover:text-rose-deep" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
