---
import { Image } from 'astro:assets';
import SpotifyLogo from '@/components/SpotifyLogo.astro';
import PinIcon from '@/components/PinIcon.astro';
import { kindOf, kindLabel, formatDate, videoUrl, excerpt, songOf, type Post } from '@/lib/lately';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data } = post;
const kind = kindOf(post);
const cover = data.photos[0];
const video = videoUrl(post);
const song = await songOf(post);
const text = excerpt(post);
const label = song
  ? `${song.title}${song.artist ? ` by ${song.artist}` : ''}, opens Spotify`
  : (data.title ?? (kind === 'quote' ? data.quote : text) ?? kindLabel[kind]);
const onMedia = kind === 'photo' || kind === 'video';
---

<a
  href={song ? song.url : `/lately/${post.id}`}
  class:list={[
    'tile group aspect-square p-5 sm:aspect-[6/5] sm:p-6',
    kind === 'quote' && '!bg-rose-soft',
    kind === 'video' && !data.poster && '!bg-paper-2',
    kind === 'song' && '!bg-[#121212]',
  ]}
  data-post={song ? undefined : post.id}
  target={song ? '_blank' : undefined}
  rel={song ? 'noopener' : undefined}
  aria-label={`${kindLabel[kind]}, ${formatDate(data.date, 'long')}${data.location ? `, ${data.location}` : ''}: ${label}`}
>
  {
    cover && kind === 'photo' && (
      <Image
        src={cover}
        alt=""
        width={cover.format === 'svg' ? undefined : 1000}
        widths={cover.format === 'svg' ? undefined : [400, 700, 1000]}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
      />
    )
  }
  {
    song?.cover && (
      <span class="pointer-events-none absolute inset-0" aria-hidden="true">
        <img src={song.cover} alt="" loading="lazy" decoding="async" class="size-full scale-125 object-cover blur-2xl brightness-[0.45] saturate-150" />
      </span>
    )
  }
  {
    video && (
      <video
        src={video}
        poster={data.poster?.src}
        muted
        loop
        playsinline
        preload="metadata"
        class="absolute inset-0 size-full object-cover"
        data-hover-play
        aria-hidden="true"
      />
    )
  }
  {onMedia && <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/55 via-transparent to-transparent" aria-hidden="true" />}

  <span class:list={['relative flex items-center gap-2 text-xs font-medium', song || data.location ? 'justify-between' : 'justify-end', onMedia || song ? 'text-ink' : 'text-muted']}>
    {
      song ? (
        <span class="flex items-center gap-2 text-sm font-semibold text-white">
          <SpotifyLogo class="size-6 text-[#1ed760]" /> Spotify
        </span>
      ) : (
        data.location && (
          <span class:list={['flex min-w-0 items-center gap-1', onMedia ? 'rounded-full bg-white/85 py-1 pr-2.5 pl-1.5 backdrop-blur-sm' : 'text-rose']}>
            <PinIcon class="size-3.5 shrink-0 text-rose-glow" />
            <span class="truncate">{data.location}</span>
          </span>
        )
      )
    }
    <span class:list={['flex shrink-0 items-center gap-2', (onMedia || song) && 'rounded-full bg-white/85 px-2.5 py-1 backdrop-blur-sm']}>
      {data.photos.length > 1 && <span>1 / {data.photos.length} ·</span>}
      <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
    </span>
  </span>

  {
    kind === 'text' && (
      <span
        class:list={[
          'relative font-display leading-[1.05] font-light tracking-tight',
          // Short thoughts get big type so the card doesn't look empty; long ones shrink to fit
          (data.title ?? text).length <= 60
            ? 'line-clamp-5 text-[clamp(2.2rem,3.4vw,2.9rem)]'
            : (data.title ?? text).length <= 140
              ? 'line-clamp-6 text-[clamp(1.8rem,2.6vw,2.2rem)]'
              : 'line-clamp-6 text-[1.6rem] leading-tight',
        ]}
      >
        {data.title ?? text}
      </span>
    )
  }
  {
    kind === 'quote' && (
      <span class="relative">
        <span class="serif-italic line-clamp-5 block text-[1.6rem] leading-tight">“{data.quote}”</span>
        {data.source && <span class="mt-3 block text-sm text-rose">{data.source}</span>}
      </span>
    )
  }
  {
    onMedia && (
      <span class="relative flex items-end justify-between gap-4 text-white">
        <span class="min-w-0">
          {data.title && <span class="block font-display text-[1.75rem] leading-tight font-light tracking-tight">{data.title}</span>}
          {text && <span class:list={['line-clamp-3 block text-[0.95rem] leading-snug drop-shadow-[0_1px_8px_rgb(0_0_0/0.45)]', data.title && 'mt-1.5 text-white/85']}>{text}</span>}
        </span>
        {kind === 'video' && (
          <span class="grid size-14 shrink-0 place-items-center rounded-full border border-white/60 bg-white/20 shadow-[0_0_24px_rgb(224_85_138/0.45)] backdrop-blur-sm transition-transform duration-500 group-hover:scale-110">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
          </span>
        )}
      </span>
    )
  }
  {
    song && (
      <span class="relative flex items-end gap-4 text-white sm:gap-5">
        {song.cover && (
          <img
            src={song.cover}
            alt=""
            width="640"
            height="640"
            loading="lazy"
            decoding="async"
            class="size-28 shrink-0 rounded-lg object-cover shadow-[0_18px_40px_-10px_rgb(0_0_0/0.7)] transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04] sm:size-32"
          />
        )}
        <span class="min-w-0 flex-1">
          <span class="line-clamp-2 block font-display text-[1.5rem] leading-tight font-light tracking-tight">{song.title}</span>
          {song.artist && <span class="mt-0.5 line-clamp-2 block text-[0.95rem] leading-snug text-white/70">{song.artist}</span>}
          {text && <span class="mt-2 line-clamp-2 block text-sm leading-snug text-white/85">{text}</span>}
        </span>
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-[#1ed760] text-black shadow-[0_8px_24px_-6px_rgb(30_215_96/0.6)] transition-transform duration-500 group-hover:scale-110">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>
        </span>
      </span>
    )
  }
</a>

<script>
  // Video tiles play a silent preview while hovered
  document.querySelectorAll<HTMLVideoElement>('video[data-hover-play]').forEach((video) => {
    const tile = video.closest('a');
    if (!tile || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    tile.addEventListener('pointerenter', () => video.play().catch(() => {}));
    tile.addEventListener('pointerleave', () => {
      video.pause();
      video.currentTime = 0;
    });
  });
</script>
