---
/**
 * A photo tile. Shows a tinted placeholder until `image` names a file in src/assets/photos/.
 */
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';

interface Props {
  label: string;
  tint: string;
  caption?: string;
  image?: string;
  class?: HTMLAttributes<'div'>['class'];
  'class:list'?: HTMLAttributes<'div'>['class:list'];
}

const { label, tint, caption, image, class: className, 'class:list': classList } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,avif}');
const loader = image ? photos[`/src/assets/photos/${image}`] : undefined;
const src = loader ? (await loader()).default : undefined;
---

<figure class:list={['swatch group flex items-end p-4', className, classList]} style={`--tint:${tint}`}>
  {
    src && (
      <Image
        src={src}
        alt={label}
        width={1200}
        widths={[400, 800, 1200]}
        sizes="(min-width: 640px) 33vw, 50vw"
        class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-105"
      />
    )
  }
  <figcaption class="relative z-10 text-sm transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:-translate-y-1">
    <span class="block font-medium text-ink/80">{label}</span>
    {caption && <span class="mono text-[0.65rem] text-ink/50">{caption}</span>}
  </figcaption>
</figure>
