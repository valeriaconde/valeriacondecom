---
import { Image } from 'astro:assets';
import type { ResolvedPresent } from '@/lib/presents';

interface Props {
  present: ResolvedPresent;
}
const { present: p } = Astro.props;
---

<a href={p.url} target="_blank" rel="noopener noreferrer" class="tile group !justify-start">
  <span class="relative block aspect-square overflow-hidden bg-white">
    {
      p.localImage ? (
        <Image
          src={p.localImage}
          alt=""
          widths={p.localImage.format === 'svg' ? undefined : [400, 700, 1000]}
          sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
          class="size-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
        />
      ) : p.remoteImage ? (
        <img
          src={p.remoteImage}
          alt=""
          loading="lazy"
          referrerpolicy="no-referrer"
          class="size-full object-contain p-6 transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
        />
      ) : (
        <span class="grid size-full place-items-center bg-rose-soft font-display text-5xl text-rose" aria-hidden="true">
          🎁
        </span>
      )
    }
    {p.price && <span class="absolute top-4 right-4 rounded-full bg-white/90 px-3 py-1 text-xs font-medium backdrop-blur-sm">{p.price}</span>}
  </span>
  <span class="flex flex-1 flex-col gap-2 border-t border-line p-5">
    <span class="flex items-center justify-between gap-3 text-xs text-muted">
      <span class="truncate">{p.domain}</span>
      <span class="arrow-ne shrink-0 group-hover:text-rose" aria-hidden="true">↗</span>
    </span>
    <span class="font-display text-xl leading-snug">{p.title}</span>
    {p.note && <span class="text-sm text-muted">{p.note}</span>}
  </span>
  <span class="sr-only">(opens the store in a new tab)</span>
</a>
